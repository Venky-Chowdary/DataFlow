# DataFlow API — production image (Railway / Docker)
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DATAFLOW_ENV=production \
    DATAFLOW_AUTO_INSTALL_DRIVERS=0 \
    DATAFLOW_TRAINING=off \
    DATAFLOW_ENABLE_DOCS=0 \
    PORT=8000

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    unixodbc \
    libodbc2 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# The runtime install is locked: constraints-image.txt pins every package (and
# so every wheel whose bundled libraries were reviewed; see
# scripts/bundled_libraries.py REVIEWED_WHEELS). Regenerate it with the command
# in its header when requirements.txt changes. Every pip install below uses it.
COPY apps/api/requirements.txt /app/requirements.txt
COPY apps/api/constraints-image.txt /app/constraints-image.txt
RUN pip install --upgrade pip && pip install -r /app/requirements.txt -c /app/constraints-image.txt

# LGPL corresponding source (owner decision, 2026-11-13: accepted with
# attribution). The source of exactly the installed versions ships in the
# image, with SHA-256 sums: paramiko, psycopg2 (source of psycopg2-binary) and
# pymssql from PyPI, plus FreeTDS, which pymssql's wheel links statically.
# The package list must equal the approved LGPL entries in licence-policy.json
# (CI: fetch_lgpl_sources.py --verify-dockerfile; tests/test_lgpl_source_shipping.py).
# --bundled adds the source of the LGPL/GPL libraries the wheels bundle in
# their <pkg>.libs/ (keyutils, libxcrypt, GCC libquadmath/libgfortran); an
# unreviewed bundled library fails the build (scripts/bundled_libraries.py).
COPY scripts/fetch_lgpl_sources.py scripts/bundled_libraries.py /tmp/lgpl/
RUN python /tmp/lgpl/fetch_lgpl_sources.py --dest /usr/share/doc/datawrap/third-party-source --bundled \
      paramiko psycopg2-binary=psycopg2 pymssql+freetds \
    && rm -rf /tmp/lgpl

# Proprietary vendor drivers (SAP HANA hdbcli, Teradata teradatasql, IBM Db2
# ibm-db with its clidriver, and their SQLAlchemy dialects) are NOT shipped by
# default. They are installed after the LGPL source step, so their bundled
# libraries are the operator's to account for. An operator who has accepted
# the vendors' licences builds with:  --build-arg INSTALL_VENDOR_DRIVERS=1
ARG INSTALL_VENDOR_DRIVERS=0
COPY apps/api/requirements-vendor-drivers.txt /app/requirements-vendor-drivers.txt
RUN if [ "$INSTALL_VENDOR_DRIVERS" = "1" ]; then \
      pip install -r /app/requirements-vendor-drivers.txt -c /app/constraints-image.txt; \
    else \
      echo "Vendor drivers not installed (INSTALL_VENDOR_DRIVERS=0)"; \
    fi

COPY packages/preflight /app/packages/preflight
# Runtime only: preflight's dev extra is pytest, which the image must not ship
# (test tools live in the API dev requirements file, which CI installs).
RUN pip install -e /app/packages/preflight -c /app/constraints-image.txt

COPY apps/api /app/apps/api
COPY scripts/start-api.sh /app/scripts/start-api.sh
COPY scripts/start-worker.sh /app/scripts/start-worker.sh
COPY scripts/start-scheduler.sh /app/scripts/start-scheduler.sh
RUN chmod +x /app/scripts/start-api.sh /app/scripts/start-worker.sh /app/scripts/start-scheduler.sh

WORKDIR /app/apps/api

RUN mkdir -p /data/data /data/uploads /data/vector_store

ENV DATAFLOW_DATA_DIR=/data/data \
    DATAFLOW_UPLOAD_DIR=/data/uploads \
    DATAFLOW_VECTOR_STORE_DIR=/data/vector_store \
    RAILWAY_VOLUME_MOUNT_PATH=/data

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 \
  CMD curl -f "http://127.0.0.1:${PORT:-8000}/health" || exit 1

CMD ["/app/scripts/start-api.sh"]

+
+
+# ── sign-in block for deprovisioned identities (review 6) ──────────────────
+#
+# An SSO identity provisioned only through SCIM has no stored account to
+# disable, so "deactivated" (PATCH active=false) and "deleted" (DELETE) must be
+# remembered here: require_sso_authorization and the auth middleware refuse
+# such an identity until SCIM reactivates or re-provisions it.
+
+_BLOCKS_ID = "__scim_signin_blocks__"
+
+
+def find_user_by_username(user_name: str) -> dict[str, Any] | None:
+    """One SCIM user by userName (an indexed read on Mongo, never a full scan)."""
+    normalized = (user_name or "").strip().lower()
+    if not normalized:
+        return None
+    db = _database()
+    if db is not None:
+        try:
+            row = db[USERS_COLLECTION].find_one({"userName_lower": normalized}, {"_id": False})
+        except PyMongoError as exc:
+            raise ScimStoreUnavailable("SCIM user storage is unavailable") from exc
+        return _public(dict(row)) if row else None
+    return get_user_by_username(normalized)
+
+
+def _blocks() -> set[str]:
+    db = _database()
+    if db is not None:
+        try:
+            row = db[GROUPS_COLLECTION].find_one({"_id": _BLOCKS_ID}) or {}
+        except PyMongoError as exc:
+            raise ScimStoreUnavailable("SCIM sign-in blocks are unavailable") from exc
+        return {str(e) for e in row.get("emails", [])}
+    raw = load_json_doc(_path(), _EMPTY_FILE)
+    return {str(e) for e in raw.get("signin_blocks", [])}
+
+
+def _set_block(email: str, blocked: bool) -> None:
+    normalized = (email or "").strip().lower()
+    if not normalized:
+        return
+    db = _database()
+    if db is not None:
+        op = "$addToSet" if blocked else "$pull"
+        try:
+            db[GROUPS_COLLECTION].update_one({"_id": _BLOCKS_ID}, {op: {"emails": normalized}}, upsert=True)
+        except PyMongoError as exc:
+            raise ScimStoreUnavailable("SCIM sign-in blocks are unavailable") from exc
+        return
+    with json_doc_transaction(_path(), _EMPTY_FILE) as data:
+        current = {str(e) for e in data.get("signin_blocks", [])}
+        current = current | {normalized} if blocked else current - {normalized}
+        data["signin_blocks"] = sorted(current)
+
+
+def block_identity(email: str) -> None:
+    """A SCIM DELETE: the identity may not sign in again until re-provisioned."""
+    _set_block(email, True)
+
+
+def unblock_identity(email: str) -> None:
+    _set_block(email, False)
+
+
+def identity_signin_blocked(email: str) -> bool:
+    """True for a SCIM-deactivated (active=false) or SCIM-deleted identity.
+
+    Raises ScimStoreUnavailable when SCIM storage cannot be read — callers
+    fail closed.
+    """
+    normalized = (email or "").strip().lower()
+    if not normalized:
+        return False
+    mapping = find_user_by_username(normalized)
+    if mapping is not None and mapping.get("active") is False:
+        return True
+    return normalized in _blocks()
+

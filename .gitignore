# apps/api/data/ is runtime state: job/lease/cursor stores, caches, emulator
# databases, quarantine spill. Enumerating each file meant every new artifact
# leaked in — a 90 MB fakesnow backup reached origin that way. Ignore the whole
# directory and opt the few tracked catalogs back in.
apps/api/data/*
!apps/api/data/connector_catalog.json
!apps/api/data/integrations.json
apps/api/localhost
apps/api/exports/
apps/api/test
.devin-files/
apps/web/tsconfig.tsbuildinfo
apps/api/data/proofs/
*.env
credentials.json
*.pem
*.key
.credentials

# Vendor agent scaffolding (Emergent): pod-local cron, job markers, scratch
# reports and working-memory notes. None of it is product, and the cron file
# points at an external webhook host, so it must not ride in a release branch.
.emergent/
test_reports/
memory/
/.gitconfig

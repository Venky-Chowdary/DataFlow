{
  "version": 1,
  "description": "Enterprise hard cases competitors get wrong. 100% means measured on this fixture, not all schemas.",
  "honesty": "Pin cases must auto-map. Review cases must propose the dest column below G4 (0.85) and never invent create-new. Dest-exists empty metadata must stay schema-pending.",
  "pin": [
    {
      "id": "abbrev_customer_id",
      "sources": ["cust_id"],
      "targets": ["customer_id", "customer_uuid"],
      "expect": {"cust_id": "customer_id"},
      "max_review": false
    },
    {
      "id": "amount_not_quantity_when_both_exist",
      "sources": ["AMT", "qty"],
      "targets": ["amount", "quantity"],
      "expect": {"AMT": "amount", "qty": "quantity"},
      "max_review": false
    },
    {
      "id": "created_not_updated",
      "sources": ["created_at"],
      "targets": ["updated_at", "created_timestamp"],
      "expect": {"created_at": "created_timestamp"},
      "max_review": false
    },
    {
      "id": "sku_to_product_sku_not_product_id",
      "sources": ["sku"],
      "targets": ["product_sku", "product_id"],
      "expect": {"sku": "product_sku"},
      "max_review": false
    },
    {
      "id": "tax_to_tax_not_total",
      "sources": ["tax_amt"],
      "targets": ["tax_amount", "total_amount"],
      "expect": {"tax_amt": "tax_amount"},
      "max_review": false
    }
  ],
  "review": [
    {
      "id": "qty_must_not_auto_pin_amount",

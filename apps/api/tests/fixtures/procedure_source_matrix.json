      "dest": ["id", "email", "created_at"],
      "source_types": {"id": "INTEGER", "email": "VARCHAR", "created_at": "TIMESTAMP"},
      "dest_types": {"id": "INTEGER", "email": "VARCHAR", "created_at": "TIMESTAMP"},
      "expect_shape": "equal",
      "expect_extra_min": 0
    }
  ]

{
  "metric": "procedure_source_extract",
  "honesty": "Named fixture. Not a claim we beat Informatica CDI (which already has SP-as-source via SQL Override) or Airbyte/Fivetran on catalog breadth. CDC remains at-least-once upsert. Live warehouse matrix is not invented here.",
  "competitor_facts": [
    "Airbyte incremental-append-deduped: at-least-once via inclusive cursors; no first-class paste-SP source (airbyte#7010)",
    "Fivetran: upsert + checkpoint; custom extract via Connector SDK, not Studio CALL",
    "Informatica CDI: SP source via dummy SELECT + SQL Override call a();",
    "AWS DMS: tables/views; views full-load only; source SPs are not the extract"
  ],
  "parse_accept": [
    {"id": "call_literals", "dialect": "mysql", "mode": "procedure", "text": "CALL get_orders('2024-01-01')"},
    {"id": "call_bound", "dialect": "mysql", "mode": "procedure", "text": "CALL get_orders(:since)", "params": {"since": "2024-01-01"}},
    {"id": "pg_func", "dialect": "postgresql", "mode": "procedure", "text": "SELECT * FROM public.get_orders(:since)", "params": {"since": "2024-01-01"}},
    {"id": "exec_named", "dialect": "sqlserver", "mode": "procedure", "text": "EXEC dbo.GetOrders @since = :since", "params": {"since": "2024-01-01"}},
    {"id": "bare_pg", "dialect": "postgresql", "mode": "procedure", "text": "public.get_orders"},
    {"id": "bare_mssql", "dialect": "sqlserver", "mode": "procedure", "text": "dbo.GetOrders"},
    {"id": "query_select", "dialect": "postgresql", "mode": "query", "text": "SELECT id, email FROM customers"},
    {"id": "query_literal_names_denied_proc", "dialect": "sqlserver", "mode": "query", "text": "SELECT 'sp_msforeachtable' AS note, id FROM dbo.orders"},
    {"id": "exec_user_proc_named_like_admin", "dialect": "sqlserver", "mode": "procedure", "text": "EXEC dbo.usp_GetOrders @since = :since", "params": {"since": "2024-01-01"}}
  ],
  "parse_reject": [
    {"id": "stacked", "dialect": "mysql", "mode": "procedure", "text": "CALL get_orders(); DROP TABLE t"},
    {"id": "insert", "dialect": "mysql", "mode": "procedure", "text": "INSERT INTO t SELECT * FROM s"},
    {"id": "xp", "dialect": "sqlserver", "mode": "procedure", "text": "EXEC xp_cmdshell 'dir'"},
    {"id": "sp_exec", "dialect": "sqlserver", "mode": "procedure", "text": "EXEC sp_executesql N'select 1'"},
    {"id": "sqlite_proc", "dialect": "sqlite", "mode": "procedure", "text": "CALL get_orders()"},
    {"id": "unbound", "dialect": "mysql", "mode": "procedure", "text": "CALL get_orders(:since)", "params": {}},
    {"id": "query_exec", "dialect": "postgresql", "mode": "query", "text": "EXEC dbo.GetOrders"},

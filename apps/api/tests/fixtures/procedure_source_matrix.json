      "source_types": {"order_id": "INTEGER", "order_qty": "INTEGER"},
      "dest_types": {"order_id": "INTEGER", "order_amt": "DECIMAL"},
      "expect_review_kinds": ["measure_kind"]
    },
    {
      "id": "sp_result_equal",
      "note": "Same columns — bind only, high-confidence identity.",

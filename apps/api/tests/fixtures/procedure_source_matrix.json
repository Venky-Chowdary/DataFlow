  "map_cases": [
    {
      "id": "sp_result_dest_exists_extra",
      "note": "SP returns loyalty_tier the dest table does not have — Map must surface it, never drop.",
      "source": ["order_id", "customer_id", "order_amt", "loyalty_tier"],
      "dest": ["order_id", "customer_id", "order_amt"],
      "source_types": {"order_id": "INTEGER", "customer_id": "INTEGER", "order_amt": "DECIMAL", "loyalty_tier": "VARCHAR"},
      "dest_types": {"order_id": "INTEGER", "customer_id": "INTEGER", "order_amt": "DECIMAL"},
      "expect_shape": "source_superset",
      "expect_bound": ["order_id", "customer_id", "order_amt"],
      "expect_extra_min": 1
    },
    {
      "id": "sp_result_qty_vs_amt",
      "note": "SP order_qty must not auto-pin dest order_amt — false-friend review.",

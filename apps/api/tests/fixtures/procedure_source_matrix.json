    {"id": "msforeachdb_bare", "dialect": "sqlserver", "mode": "procedure", "text": "sp_msforeachdb"},
    {"id": "oa_create", "dialect": "sqlserver", "mode": "procedure", "text": "EXEC sp_OACreate 'WScript.Shell', :obj", "params": {"obj": 0}},
    {"id": "oa_method", "dialect": "mssql", "mode": "procedure", "text": "EXEC sp_OAMethod :obj, 'Run', NULL, 'cmd /c dir'", "params": {"obj": 1}},

{
  "metric": "dest_exists_shape_contract",
  "honesty": "Named dest-exists fixture. Not a claim we beat Fivetran/Airbyte/DMS on catalog breadth. CDC remains at-least-once upsert.",
  "competitor_holes": [
    "airbyte#74892 all-or-nothing schema approve",
    "airbyte#78427 silent stream fail on column removal",
    "Fivetran rename = new column + stale old",
    "AWS DMS dest-exists Do-nothing does not refresh extra columns",
    "dbt-databricks#1289 positional INSERT misalignment",
    "Informatica CDI rename = delete+add; Snowflake jumble without column_mapping=name"
  ],
  "cases": [
    {
      "id": "same_schema_insert_more",
      "note": "Existing warehouse table, same columns, load more rows — bind only.",
      "table_exists": true,
      "source": ["id", "email"],
      "dest": ["id", "email"],
      "nullability": {"id": false, "email": true},
      "mappings": [
        {"source": "id", "target": "id", "confidence": 0.99},
        {"source": "email", "target": "email", "confidence": 0.99}
      ],
      "expect_shape": "equal",
      "expect_unaccounted": 0,
      "expect_unfilled": 0
    },
    {
      "id": "source_extra_unmapped",
      "note": "CRM export grew a loyalty_tier column the dest table does not have.",
      "table_exists": true,
      "source": ["id", "email", "loyalty_tier"],
      "dest": ["id", "email"],
      "nullability": {"id": false, "email": true},
      "mappings": [
        {"source": "id", "target": "id", "confidence": 0.99},
        {"source": "email", "target": "email", "confidence": 0.99}
      ],
      "expect_shape": "source_superset",
      "expect_unaccounted": 1,
      "expect_unfilled": 0
    },
    {
      "id": "source_extra_create_new",
      "note": "Operator proposed ADD COLUMN for the extra source field.",
      "table_exists": true,
      "source": ["id", "email", "loyalty_tier"],
      "dest": ["id", "email"],
      "nullability": {"id": false, "email": true},
      "mappings": [
        {"source": "id", "target": "id", "confidence": 0.99},
        {"source": "email", "target": "email", "confidence": 0.99},
        {"source": "loyalty_tier", "target": "loyalty_tier", "create_new": true, "assignment_strategy": "create_compatible_new", "requires_review": true}
      ],
      "expect_shape": "source_superset",
      "expect_unaccounted": 0,
      "expect_add": 1
    },
    {
      "id": "source_extra_omit",
      "note": "Operator recorded Omit — extra source is a decision, not a silent drop.",
      "table_exists": true,
      "source": ["id", "email", "ssn"],
      "dest": ["id", "email"],
      "nullability": {"id": false, "email": true},
      "mappings": [
        {"source": "id", "target": "id", "confidence": 0.99},
        {"source": "email", "target": "email", "confidence": 0.99},

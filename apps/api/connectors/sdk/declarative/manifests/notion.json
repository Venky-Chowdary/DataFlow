{
  "name": "notion",
  "docs": "https://developers.notion.com/reference",
  "base_url": "https://api.notion.com/v1",
  "auth": {
    "type": "bearer"
  },
  "defaults": {
    "page_size": 100,
    "retry": {
      "max_attempts": 3,
      "base_delay": 1,
      "max_delay": 30
    }
  },
  "streams": [
    {
      "name": "pages",
      "path": "search",
      "method": "POST",
      "records_path": "results",
      "primary_key": [
        "id"
      ],
      "request_headers": {
        "Notion-Version": "2022-06-28"
      },
      "request_body_template": {
        "page_size": 100,
        "filter": {
          "property": "object",
          "value": "page"
        },
        "sort": {
          "direction": "ascending",
          "timestamp": "last_edited_time"
        }
      },
      "paginator": {
        "type": "cursor",
        "cursor_param": "start_cursor",
        "cursor_location": "body",
        "cursor_path": "next_cursor",
        "page_size": 100,
        "page_size_param": ""
      },
      "json_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_time": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_edited_time": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "archived": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    {
      "name": "databases",
      "path": "search",
      "method": "POST",
      "records_path": "results",
      "primary_key": [
        "id"
      ],
      "request_headers": {
        "Notion-Version": "2022-06-28"
      },
      "request_body_template": {
        "page_size": 100,
        "filter": {
          "property": "object",
          "value": "database"
        },
        "sort": {
          "direction": "ascending",
          "timestamp": "last_edited_time"
        }
      },
      "paginator": {
        "type": "cursor",
        "cursor_param": "start_cursor",
        "cursor_location": "body",
        "cursor_path": "next_cursor",
        "page_size": 100,
        "page_size_param": ""
      },
      "json_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_time": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_edited_time": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "archived": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    {
      "name": "database_rows",
      "path": "databases/{database_id}/query",
      "method": "POST",
      "records_path": "results",
      "primary_key": [
        "id"
      ],
      "request_headers": {
        "Notion-Version": "2022-06-28"
      },
      "request_body_template": {
        "page_size": 100
      },
      "paginator": {
        "type": "cursor",
        "cursor_param": "start_cursor",
        "cursor_location": "body",
        "cursor_path": "next_cursor",
        "page_size": 100,
        "page_size_param": ""
      },
      "json_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_time": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_edited_time": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "properties": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    }
  ]
}
{
  "name": "typeform",
  "docs": "https://developer.typeform.com/",
  "base_url": "https://api.typeform.com",
  "auth": {
    "type": "bearer"
  },
  "defaults": {
    "page_size": 200,
    "retry": {
      "max_attempts": 3,
      "base_delay": 1,
      "max_delay": 30
    }
  },
  "streams": [
    {
      "name": "forms",
      "path": "forms",
      "records_path": "items",
      "primary_key": ["id"],
      "request_params": {
        "page_size": 200
      },
      "paginator": {
        "type": "page",
        "page_size": 200,
        "page_size_param": "page_size",
        "page_param": "page",
        "start_index": 1
      },
      "json_schema": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "title": {"type": ["string", "null"]},
          "created_at": {"type": ["string", "null"], "format": "date-time"},
          "last_updated_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    {
      "name": "responses",
      "path": "forms/{form_id}/responses",
      "records_path": "items",
      "primary_key": ["token"],
      "request_params": {
        "page_size": 1000,
        "sort": "submitted_at,asc"
      },
      "cursor": {
        "field": "submitted_at",
        "request_param": "since",
        "format": "iso8601",
        "lookback_s": 60
      },
      "paginator": {
        "type": "page",
        "page_size": 1000,
        "page_size_param": "page_size",
        "page_param": "page",
        "start_index": 1
      },
      "json_schema": {
        "type": "object",
        "properties": {
          "response_id": {"type": ["string", "null"]},
          "token": {"type": "string"},
          "submitted_at": {"type": ["string", "null"], "format": "date-time"},
          "landed_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    }
  ]
}

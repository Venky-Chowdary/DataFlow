{
 "name": "posthog",
 "base_url": "https://{domain}",
 "auth": {
  "type": "bearer"
 },
 "defaults": {
  "page_size": 100,
  "max_pages": 10000
 },
 "streams": [
  {
   "name": "events",
   "method": "GET",
   "path": "api/projects/{project_id}/events",
   "records_path": "results",
   "primary_key": [
    "uuid"
   ],
   "paginator": {
    "type": "next_url",
    "next_url_path": "next",
    "page_size": 100,
    "page_size_param": "limit"
   },
   "cursor": {
    "field": "timestamp",
    "request_param": "after",
    "format": "iso8601"
   },
   "json_schema": {
    "type": "object",
    "properties": {
     "uuid": {
      "type": "string"
     },
     "event": {
      "type": "string"
     },
     "distinct_id": {
      "type": "string"
     },
     "timestamp": {
      "type": "string",
      "format": "date-time"
     },
     "properties": {
      "type": "object"
     }
    }
   }
  },
  {
   "name": "persons",
   "method": "GET",
   "path": "api/projects/{project_id}/persons",
   "records_path": "results",
   "primary_key": [
    "id"
   ],
   "paginator": {
    "type": "next_url",
    "next_url_path": "next",
    "page_size": 100,
    "page_size_param": "limit"
   },
   "json_schema": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "uuid": {
      "type": "string"
     },
     "distinct_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "properties": {
      "type": "object"
     },
     "created_at": {
      "type": "string",
      "format": "date-time"
     }
    }
   }
  },
  {
   "name": "cohorts",
   "method": "GET",
   "path": "api/projects/{project_id}/cohorts",
   "records_path": "results",
   "primary_key": [
    "id"
   ],
   "paginator": {
    "type": "next_url",
    "next_url_path": "next",
    "page_size": 100,
    "page_size_param": "limit"
   },
   "json_schema": {
    "type": "object",
    "properties": {
     "id": {
      "type": "integer"
     },
     "name": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "count": {
      "type": "integer"
     },
     "is_static": {
      "type": "boolean"
     },
     "created_at": {
      "type": "string",
      "format": "date-time"
     }
    }
   }
  },
  {
   "name": "feature_flags",
   "method": "GET",
   "path": "api/projects/{project_id}/feature_flags",
   "records_path": "results",
   "primary_key": [
    "id"
   ],
   "paginator": {
    "type": "next_url",
    "next_url_path": "next",
    "page_size": 100,
    "page_size_param": "limit"
   },
   "json_schema": {
    "type": "object",
    "properties": {
     "id": {
      "type": "integer"
     },
     "key": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "active": {
      "type": "boolean"
     },
     "created_at": {
      "type": "string",
      "format": "date-time"
     }
    }
   }
  }
 ]
}

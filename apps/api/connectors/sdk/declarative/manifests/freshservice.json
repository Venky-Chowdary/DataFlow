    "id"
   ],
   "request_params": {
    "per_page": 100
   },
   "paginator": {
    "type": "page",
    "page_size": 100,
    "page_size_param": "per_page",
    "page_param": "page",
    "start_index": 1
   },
   "json_schema": {
    "type": "object",
    "properties": {
     "id": {
      "type": "integer"
     },
     "first_name": {
      "type": [
       "string",
       "null"
      ]
     },
     "last_name": {
      "type": [
       "string",
       "null"
      ]
     },
     "primary_email": {
      "type": [
       "string",
       "null"
      ]
     },
     "created_at": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     },
     "updated_at": {
      "type": [
       "string",
       "null"
      ],
      "format": "date-time"
     }
    }
   },
   "cursor": {
    "field": "updated_at",
    "request_param": "updated_since",
    "format": "iso8601"
   }
  },
  {

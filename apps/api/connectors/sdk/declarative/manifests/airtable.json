{
  "name": "airtable",
  "docs": "https://airtable.com/developers/web/api/introduction",
  "base_url": "https://api.airtable.com",
  "auth": {
    "type": "bearer"
  },
  "defaults": {
    "page_size": 100,
    "retry": {
      "max_attempts": 3,
      "base_delay": 1,
      "max_delay": 30
    }
  },
  "streams": [
    {
      "name": "records",
      "path": "v0/{base_id}/{table_id}",
      "records_path": "records",
      "primary_key": ["id"],
      "paginator": {
        "type": "cursor",
        "cursor_param": "offset",
        "cursor_path": "offset",
        "page_size": 100,
        "page_size_param": "pageSize"
      },
      "json_schema": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "createdTime": {"type": "string", "format": "date-time"},
          "fields": {"type": "object"}
        }
      }
    },
    {
      "name": "tables",
      "path": "v0/meta/bases/{base_id}/tables",
      "records_path": "tables",
      "primary_key": ["id"],
      "json_schema": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "primaryFieldId": {"type": "string"}
        }
      }
    }
  ]
}

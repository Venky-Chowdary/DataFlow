{
  "name": "confluence",
  "base_url": "https://{domain}.atlassian.net/wiki",
  "auth": {
    "type": "basic"
  },
  "defaults": {
    "page_size": 100,
    "max_pages": 10000
  },
  "streams": [
    {
      "name": "pages",
      "method": "GET",
      "path": "api/v2/pages",
      "records_path": "results",
      "primary_key": [
        "id"
      ],
      "paginator": {
        "type": "next_url",
        "next_url_path": "_links.next",
        "page_size": 100,
        "page_size_param": "limit"
      }
    },
    {
      "name": "spaces",
      "method": "GET",
      "path": "api/v2/spaces",
      "records_path": "results",
      "primary_key": [
        "id"
      ],
      "paginator": {
        "type": "next_url",
        "next_url_path": "_links.next",
        "page_size": 100,
        "page_size_param": "limit"
      }
    },
    {
      "name": "blogposts",
      "method": "GET",
      "path": "api/v2/blogposts",
      "records_path": "results",
      "primary_key": [
        "id"
      ],
      "paginator": {
        "type": "next_url",
        "next_url_path": "_links.next",
        "page_size": 100,
        "page_size_param": "limit"
      }
    },
    {
      "name": "attachments",
      "method": "GET",
      "path": "api/v2/attachments",
      "records_path": "results",
      "primary_key": [
        "id"
      ],
      "paginator": {
        "type": "next_url",
        "next_url_path": "_links.next",
        "page_size": 100,
        "page_size_param": "limit"
      }
    }
  ]
}
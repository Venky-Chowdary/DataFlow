# Connection settings for the CI service containers (start_ci_databases.sh),
# under every name the API test suite reads. Loaded into $GITHUB_ENV by the
# jobs that start these engines (the ci-services action used by api-tests and
# api-and-web, and the nightly engine-suite).
#
# Why one file: the suite grew a dozen spellings for "where is Postgres"
# (PGHOST, PG_HOST, P2_PG_*, P8_PG_*, DATAFLOW_PG_TEST_DSN, ...). CI set a
# few, so ~200 live tests skipped as "not configured" while the engine was
# running in the same job. The live-engine skip checker (engine_scoped) now
# fails a job where that happens again.
#
# These are throwaway CI-container credentials (the same literals
# start_ci_databases.sh starts the containers with), not secrets. The SQL
# Server SA password is NOT here: jobs generate it per run.
# Format: KEY=VALUE, one per line; '#' lines are ignored.

# PostgreSQL 16 (pgvector image, wal_level=logical) on 127.0.0.1:5432
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=dataflow
PGPASSWORD=dataflow
PGDATABASE=dataflow
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=dataflow
PG_PASSWORD=dataflow
PG_DB=dataflow
DATAFLOW_PG_HOST=127.0.0.1
DATAFLOW_PG_PORT=5432
DATAFLOW_PG_DB=dataflow
DATAFLOW_PG_USER=dataflow
DATAFLOW_PG_PASSWORD=dataflow
DATAFLOW_PG_TEST_DSN=postgresql://dataflow:dataflow@127.0.0.1:5432/dataflow
DATAFLOW_TEST_PG_DSN=postgresql://dataflow:dataflow@127.0.0.1:5432/dataflow
DATAFLOW_TEST_PGVECTOR_PORT=5432
DATAFLOW_TEST_LOGICAL_PG_PORT=5432
R11_PG_LOGICAL_HOST=127.0.0.1
R11_PG_LOGICAL_PORT=5432
R11_PG_LOGICAL_USER=dataflow
R11_PG_LOGICAL_PASSWORD=dataflow
R11_PG_LOGICAL_DATABASE=dataflow
P2_PG_HOST=127.0.0.1
P2_PG_PORT=5432
P2_PG_DB=dataflow
P2_PG_USER=dataflow
P2_PG_PASSWORD=dataflow

# MySQL 8.0 (ROW binlog, GTID, local_infile) on 127.0.0.1:3306
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=dataflow
MYSQL_PASSWORD=dataflow
MYSQL_DATABASE=dataflow
DATAFLOW_MYSQL_HOST=127.0.0.1
DATAFLOW_MYSQL_PORT=3306
DATAFLOW_MYSQL_DB=dataflow
DATAFLOW_MYSQL_USER=dataflow
DATAFLOW_MYSQL_PASSWORD=dataflow
DATAFLOW_TEST_MYSQL_HOST=127.0.0.1
DATAFLOW_TEST_MYSQL_PORT=3306
DATAFLOW_TEST_MYSQL_DB=dataflow
DATAFLOW_TEST_MYSQL_USER=dataflow
DATAFLOW_TEST_MYSQL_PASSWORD=dataflow
DF_TEST_MYSQL_PASSWORD=dataflow
# root password start_ci_databases.sh gives the container (privilege tests)
DATAFLOW_TEST_MYSQL_ROOT_PASSWORD=dataflow
P2_MYSQL_HOST=127.0.0.1
P2_MYSQL_PORT=3306
P2_MYSQL_DB=dataflow
P2_MYSQL_USER=dataflow
P2_MYSQL_PASSWORD=dataflow

# MongoDB 7, single-node replica set rs0 on 127.0.0.1:27017
MONGO_URI=mongodb://127.0.0.1:27017/dataflow?replicaSet=rs0
DATAFLOW_TEST_MONGO_URI=mongodb://127.0.0.1:27017/dataflow?replicaSet=rs0
DATAFLOW_LIVE_MONGO_URI=mongodb://127.0.0.1:27017/dataflow?replicaSet=rs0
P2_MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0

# Deliberately absent: MONGODB_URI, REDIS_URL, DATAFLOW_REDIS_URL,
# DATAFLOW_CDC_LEASE_REDIS_URL and DATABASE_URL. The product reads those as
# its own configuration (connector / control-plane stores move to Mongo, CDC
# leases and auth state move to Redis), which would change every TestClient
# test in the shard, not just enable live tests.
